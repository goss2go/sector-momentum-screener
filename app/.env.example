# Public Supabase config (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only -- used by the API route that proxies to the worker.
# Same value as the worker's WORKER_API_KEY. Never prefix with NEXT_PUBLIC_.
WORKER_API_KEY=change-me
WORKER_URL=https://your-worker.up.railway.app
