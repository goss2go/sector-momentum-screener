# Supabase project URL and SERVICE ROLE key (not the anon key -- this
# bypasses RLS so the worker can write scan results on a user's behalf).
# Service role key must NEVER be exposed to the Next.js app or browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret between the Next.js app and this worker. Generate with
# `openssl rand -hex 32`. Set the same value in the Next.js app's
# WORKER_API_KEY env var.
WORKER_API_KEY=change-me
